# Copiar a .env.local y rellenar. .env.local NO se sube a git.
# En Vercel estas dos variables se definen en Settings -> Environment Variables.
# Al ser NEXT_PUBLIC_* se congelan en el build: si las cambias, hay que redeploy.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# No añadas nunca la service_role / secret key en este proyecto:
# todo el acceso a datos va con la sesion del usuario autenticado y RLS.
