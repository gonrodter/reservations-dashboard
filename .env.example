# Copiar a .env.local y rellenar. .env.local NO se sube a git.
# En Vercel estas variables se definen en Settings -> Environment Variables.
# Al ser NEXT_PUBLIC_* se congelan en el build: si las cambias, hay que redeploy.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Exclusivas del servidor. Nunca uses el prefijo NEXT_PUBLIC_ para estos valores.
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
APP_URL=https://reservations.example.com

# Opcional hasta activar Header Auth en los workflows de n8n. Cuando se configure,
# usa exactamente el mismo secreto en Vercel y en los cuatro webhooks.
# N8N_WEBHOOK_SECRET=REEMPLAZAR_CON_UN_SECRETO_LARGO_Y_ALEATORIO
